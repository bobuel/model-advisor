    {
      "id": "uncertainty",
      "kind": "opinion",
      "statement": "One success or a small decision-score difference is weak evidence. Treat close candidates as plausibly tied; reserve confidence for repeated, relevant, independently graded outcomes.",
      "basis": [
        "anthropic-evals",
        "openai-benchmark-audit"
      ]
    },
    {
      "id": "harness-scope",
      "kind": "opinion",
      "statement": "Code-only success cannot establish performance with filesystem, browser, network, or multi-file tools. Do not transfer this evidence to those harnesses without testing.",
      "basis": [
        "anthropic-evals"
      ]
    },
    {
      "id": "effort-fit",
      "kind": "opinion",
      "statement": "Use task complexity to choose effort. Low is a plausible starting point for small bounded edits; consider higher effort for difficult reasoning or broad changes. Higher effort is not automatically better. Model descriptions are provider guidance, not benchmark results.",
